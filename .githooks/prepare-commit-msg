#!/bin/sh
# Haengt an jede Commit-Message einen Device-Trailer an, damit in der History
# sichtbar bleibt, an welchem Rechner die Aenderung entstanden ist.
#
# Geraetename: `git config --global device.name`, Fallback = hostname.
# Wird nur ergaenzt, wenn noch kein Device-Trailer in der Message steht
# (verhindert Doppelung bei --amend und beim Rebase).

MSG_FILE="$1"
[ -f "$MSG_FILE" ] || exit 0

DEVICE=$(git config device.name 2>/dev/null)
[ -n "$DEVICE" ] || DEVICE=$(hostname)

grep -qi '^Device:' "$MSG_FILE" && exit 0

printf '\nDevice: %s\n' "$DEVICE" >> "$MSG_FILE"
exit 0
